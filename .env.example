# LLM Provider 선택: anthropic | gemini
LLM_PROVIDER=gemini

# Anthropic (LLM_PROVIDER=anthropic 일 때)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-20250514

# Gemini (LLM_PROVIDER=gemini 일 때)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SQLite DB 경로
SQLITE_PATH=data/knowledge.db

# Agent
MAX_STEPS=5
VECTOR_SEARCH_TOP_K=5
WEB_SEARCH_TOP_K=5

# 인증 (python -c "import secrets; print(secrets.token_hex(32))" 으로 AUTH_TOKEN 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here
AUTH_TOKEN=your_random_token_here
